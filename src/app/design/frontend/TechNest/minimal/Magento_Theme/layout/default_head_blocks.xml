<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <!-- System font stack only: drop Luma's Open Sans preloads -->
        <remove src="fonts/opensans/light/opensans-300.woff2"/>
        <remove src="fonts/opensans/regular/opensans-400.woff2"/>
        <remove src="fonts/opensans/semibold/opensans-600.woff2"/>
        <remove src="fonts/opensans/bold/opensans-700.woff2"/>
        <link src="Magento_Theme::favicon-32.png" rel="icon" type="image/png" sizes="32x32"/>
        <link src="Magento_Theme::apple-touch-icon.png" rel="apple-touch-icon" sizes="180x180"/>
        <meta name="theme-color" content="#ffffff"/>
    </head>
</page>
