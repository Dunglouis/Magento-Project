        <observer name="technest_require_phone" instance="TechNest\CustomerAccess\Observer\RequirePhoneOnAccountForm"/>
    </event>
    <event name="controller_action_predispatch_customer_account_editpost">
        <observer name="technest_require_phone" instance="TechNest\CustomerAccess\Observer\RequirePhoneOnAccountForm"/>
