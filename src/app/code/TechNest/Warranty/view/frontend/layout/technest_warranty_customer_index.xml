<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <body>
        <referenceContainer name="content">
            <block name="technest.warranty.customer" template="TechNest_Warranty::customer.phtml" cacheable="false">
                <arguments>
                    <argument name="view_model" xsi:type="object">TechNest\Warranty\ViewModel\CustomerWarranties</argument>
                    <argument name="lookup_view_model" xsi:type="object">TechNest\Warranty\ViewModel\Lookup</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
