<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="technest_warranty" resource="default" engine="innodb" comment="TechNest warranties by serial number">
        <column xsi:type="int" name="warranty_id" unsigned="true" nullable="false" identity="true" comment="Warranty ID"/>
        <column xsi:type="varchar" name="serial" length="32" nullable="false" comment="Serial number"/>
        <column xsi:type="int" name="order_id" unsigned="true" nullable="true" comment="Order ID"/>
        <column xsi:type="varchar" name="order_increment_id" length="50" nullable="true" comment="Order number"/>
        <column xsi:type="varchar" name="sku" length="64" nullable="false" comment="Product SKU"/>
        <column xsi:type="varchar" name="product_name" length="255" nullable="false" comment="Product name"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="true" comment="Customer ID"/>
        <column xsi:type="varchar" name="customer_email" length="255" nullable="true" comment="Customer email"/>
        <column xsi:type="varchar" name="customer_name" length="255" nullable="true" comment="Customer name"/>
        <column xsi:type="date" name="starts_at" nullable="false" comment="Cover starts (store date)"/>
        <column xsi:type="smallint" name="months" unsigned="true" nullable="false" default="12" comment="Cover length in months"/>
        <column xsi:type="date" name="expires_at" nullable="false" comment="Cover ends (store date, inclusive)"/>
        <column xsi:type="varchar" name="status" length="16" nullable="false" default="active" comment="active, expired or void"/>
        <column xsi:type="text" name="note" nullable="true" comment="Admin note"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created at"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated at"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="warranty_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="TECHNEST_WARRANTY_SERIAL">
            <column name="serial"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="TECHNEST_WARRANTY_ORDER_ID_SALES_ORDER_ENTITY_ID"
                    table="technest_warranty" column="order_id"
                    referenceTable="sales_order" referenceColumn="entity_id" onDelete="SET NULL"/>
        <constraint xsi:type="foreign" referenceId="TECHNEST_WARRANTY_CUSTOMER_ID_CUSTOMER_ENTITY_ENTITY_ID"
                    table="technest_warranty" column="customer_id"
                    referenceTable="customer_entity" referenceColumn="entity_id" onDelete="SET NULL"/>
        <index referenceId="TECHNEST_WARRANTY_STATUS_EXPIRES_AT" indexType="btree">
            <column name="status"/>
            <column name="expires_at"/>
        </index>
    </table>
</schema>
