<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="technest_google_account" resource="default" engine="innodb" comment="TechNest Google account links">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Link ID"/>
        <column xsi:type="varchar" name="google_sub" length="255" nullable="false" comment="Google subject (sub claim)"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="false" comment="Customer ID"/>
        <column xsi:type="varchar" name="email" length="255" nullable="false" comment="Google email at link time"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Linked at"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="TECHNEST_GOOGLE_ACCOUNT_GOOGLE_SUB">
            <column name="google_sub"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="TECHNEST_GOOGLE_ACCOUNT_CUSTOMER_ID">
            <column name="customer_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="TECHNEST_GOOGLE_ACCOUNT_CUSTOMER_ID_CUSTOMER_ENTITY_ENTITY_ID"
                    table="technest_google_account" column="customer_id"
                    referenceTable="customer_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
    </table>
</schema>
