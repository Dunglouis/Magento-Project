<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Email\Model\Transport">
        <plugin name="technest_mail_smtp" type="TechNest\Mail\Plugin\SendThroughSmtp"/>
    </type>
    <!-- Keep the SMTP server out of app/etc/config.php when running app:config:dump -->
    <type name="Magento\Config\Model\Config\TypePool">
        <arguments>
            <argument name="sensitive" xsi:type="array">
                <item name="technest_mail/smtp/username" xsi:type="string">1</item>
                <item name="technest_mail/smtp/password" xsi:type="string">1</item>
                <item name="technest_mail/smtp/from_email" xsi:type="string">1</item>
            </argument>
            <argument name="environment" xsi:type="array">
                <item name="technest_mail/smtp/enabled" xsi:type="string">1</item>
                <item name="technest_mail/smtp/host" xsi:type="string">1</item>
                <item name="technest_mail/smtp/port" xsi:type="string">1</item>
                <item name="technest_mail/smtp/encryption" xsi:type="string">1</item>
                <item name="technest_mail/smtp/auth" xsi:type="string">1</item>
            </argument>
        </arguments>
    </type>
</config>
