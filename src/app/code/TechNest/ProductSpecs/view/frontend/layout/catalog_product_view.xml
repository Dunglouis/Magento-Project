<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- "More Information" tab becomes a specification sheet grouped like the attribute set -->
        <referenceBlock name="product.attributes" template="TechNest_ProductSpecs::product/specs.phtml">
            <arguments>
                <argument name="title" translate="true" xsi:type="string">Specifications</argument>
                <argument name="view_model" xsi:type="object">TechNest\ProductSpecs\ViewModel\Specs</argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
