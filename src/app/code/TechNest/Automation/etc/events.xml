<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!-- Order saved (storefront and admin orders) -->
    <event name="sales_model_service_quote_submit_success">
        <observer name="technest_issue_warranties" instance="TechNest\Automation\Observer\IssueWarranties"/>
    </event>
    <event name="order_cancel_after">
        <observer name="technest_void_warranties" instance="TechNest\Automation\Observer\VoidWarranties"/>
    </event>
</config>
