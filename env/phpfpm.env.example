BLACKFIRE_CLIENT_ID=
BLACKFIRE_CLIENT_TOKEN=
COMPOSER_DISABLE_XDEBUG_WARN=1
PHP_CS_FIXER_IGNORE_ENV=1
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# TechNest QA customer qa@technest.test (bin/magento technest:seed:run --step=accounts)
TECHNEST_QA_PASSWORD=changeme

# TechNest Mail (TechNest_Mail): store emails go through this SMTP server. Dev default: Mailcatcher (http://localhost:1080).
# For real mail with Gmail: HOST=smtp.gmail.com, PORT=587, ENCRYPTION=tls, AUTH=login, USERNAME and FROM_EMAIL = your
# Gmail address, PASSWORD = a Gmail App Password. Then run bin/restart (env changes need a container restart).
# A variable set here wins over Stores > Configuration > TechNest > Mail (SMTP).
CONFIG__DEFAULT__TECHNEST_MAIL__SMTP__ENABLED=1
CONFIG__DEFAULT__TECHNEST_MAIL__SMTP__HOST=mailcatcher
CONFIG__DEFAULT__TECHNEST_MAIL__SMTP__PORT=1025
CONFIG__DEFAULT__TECHNEST_MAIL__SMTP__ENCRYPTION=none
CONFIG__DEFAULT__TECHNEST_MAIL__SMTP__AUTH=none
#CONFIG__DEFAULT__TECHNEST_MAIL__SMTP__USERNAME=
#CONFIG__DEFAULT__TECHNEST_MAIL__SMTP__PASSWORD=
#CONFIG__DEFAULT__TECHNEST_MAIL__SMTP__FROM_EMAIL=
# The address customers see in email bodies ("email us at ...") is the support sender; set it to your real one too:
#CONFIG__DEFAULT__TRANS_EMAIL__IDENT_SUPPORT__EMAIL=

# TechNest Google Login (TechNest_GoogleLogin). OAuth client (Web application) from Google Cloud Console.
# Authorized redirect URI: dev http://localhost/technest_google/oauth/callback (scripts/env/install.sh sets the
# staging/production one). Uncomment, fill in and restart the container.
#CONFIG__DEFAULT__TECHNEST_GOOGLE__GENERAL__ENABLED=1
#CONFIG__DEFAULT__TECHNEST_GOOGLE__GENERAL__CLIENT_ID=
#CONFIG__DEFAULT__TECHNEST_GOOGLE__GENERAL__CLIENT_SECRET=
#CONFIG__DEFAULT__TECHNEST_GOOGLE__GENERAL__REDIRECT_URI=http://localhost/technest_google/oauth/callback

# TechNest Data Seeder: Open Icecat username (free account at icecat.biz) for product images and specs
# (bin/magento technest:seed:run). Without it products get no Icecat images or specs.
CONFIG__DEFAULT__TECHNEST_SEEDER__ICECAT__USERNAME=
